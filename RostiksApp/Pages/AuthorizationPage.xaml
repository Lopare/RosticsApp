<Page x:Class="RostiksApp.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RostiksApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="AuthorizationPage">

    <Grid Background="#FFE8F5E9">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FFC8E6C9">
            <Grid>
                <TextBlock Text="ROSTICS" FontSize="28" FontWeight="Bold" 
                           Foreground="#FF2E7D32" VerticalAlignment="Center" 
                           Margin="20,0,0,0"/>

            </Grid>
        </Border>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Width="350">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Height="35" Margin="0,0,0,15" 
                     Padding="5"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Margin="0,0,0,20" 
                         Padding="5"/>

            <Button x:Name="LoginButton" Content="Войти" Height="40" 
                    Background="#FFA5D6A7" BorderThickness="0" 
                    FontSize="16" Cursor="Hand" Margin="0,0,0,10"
                    Click="LoginButton_Click"/>

            <Button x:Name="GuestButton" Content="Войти как гость" Height="40" 
                    Background="#FFBDBDBD" BorderThickness="0" 
                    FontSize="16" Cursor="Hand"
                    Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
<Page x:Class="RostiksApp.Pages.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RostiksApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="MenuPage">

    <Grid Background="#FFE8F5E9">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#FFC8E6C9">
            <Grid>
                <TextBlock Text="ROSTICS" FontSize="28" FontWeight="Bold" 
                           Foreground="#FF2E7D32" VerticalAlignment="Center" 
                           Margin="20,0,0,0"/>
                <TextBlock x:Name="UserRoleText" Text="Гость" FontSize="20" 
                           FontWeight="Bold" HorizontalAlignment="Right" 
                           VerticalAlignment="Center" Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- Список блюд -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      Margin="10">
            <WrapPanel x:Name="DishesWrapPanel" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="LogoutButton" Content="Выход" Width="150" Height="40" 
                    Background="#FFEF9A9A" BorderThickness="0" FontSize="16" 
                    Cursor="Hand" Margin="0,0,10,0"
                    Click="LogoutButton_Click"/>
        </StackPanel>
    </Grid>
</Page>